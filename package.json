{
  "name": "architecting-candor",
  "private": true,
  "version": "1.0.0",
  "license": "MIT AND CC-BY-4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm check:grading && pnpm check:valve && pnpm check:tripwire && pnpm check:linter && pnpm check:citation && pnpm check:glossary && pnpm check:reading-time && pnpm check:breakpoints && pnpm check:fonts && pnpm check:colors && pnpm check:vtt",
    "check:grading": "jiti scripts/check-grading.ts",
    "check:breakpoints": "jiti scripts/check-breakpoints.ts",
    "check:valve": "jiti scripts/check-valve.ts",
    "check:tripwire": "jiti scripts/check-tripwire.ts",
    "check:linter": "jiti scripts/check-linter.ts",
    "check:citation": "jiti scripts/check-citation.ts",
    "check:glossary": "jiti scripts/check-glossary.ts",
    "check:reading-time": "jiti scripts/check-reading-time.ts",
    "check:fonts": "jiti scripts/check-fonts.ts",
    "check:colors": "jiti scripts/check-colors.ts",
    "check:vtt": "jiti scripts/check-vtt.ts",
    "vtt": "jiti scripts/build-vtt.ts",
    "fonts:fallbacks": "node scripts/font-fallbacks.mjs",
    "colors:fallbacks": "node scripts/color-fallbacks.mjs",
    "check:keyboard": "node scripts/check-keyboard.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "check:lighthouse": "node scripts/lighthouse.mjs",
    "read:aloud": "jiti scripts/read-aloud.ts",
    "og": "node scripts/render-og.mjs"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "culori": "^4.0.2",
    "jiti": "^2.7.0",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.13.0"
  },
  "packageManager": "pnpm@11.13.1"
}
